# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Secret key (sb_secret_...) or the legacy "service_role" key. Server only, never expose.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Public URL of this app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "fake" (test page, default) or "youpi"
PAYMENT_PROVIDER=fake

# YouPI PG (only when PAYMENT_PROVIDER=youpi). From the gateway's Merchant Admin.
# Payment API base URL (port 6100 by default), not the checkout portal.
YOUPI_API_URL=http://localhost:6100
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# Merchant webhook secret; also sent as X-Merchant-Key. Server only.
YOUPI_WEBHOOK_SECRET=
