# ── Dependencies ──
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build output ──
/.next/
/out/
/build
/dist
.turbo
.vercel
*.tsbuildinfo
next-env.d.ts

# ── Environment & secrets (only the template is committed) ──
.env*
!.env.example
*.pem
*.key
*.p12

# ── Supabase CLI local state ──
supabase/.temp/
supabase/.branches/
supabase/.env*

# ── Testing ──
/coverage
/playwright-report
/test-results
/blob-report

# ── Logs & caches ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.cache

# ── Editors ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code (personal settings; shared .claude/settings.json stays committed) ──
.claude/settings.local.json
