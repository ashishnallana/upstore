# YouPI gateway settings. `npm run gateway:init` copies this to gateway/.env and
# fills every secret with a fresh random value. Never commit gateway/.env.

# ── Mode ──
# localhost: URLs below are used as-is (local dev / LAN).
# production: requires CLOUDFLARE_DOMAIN; checkout = https://<prefix>.<domain>, API = https://<prefix>-api.<domain>.
NODE_ENV=production
YOUPI_MODE=localhost
YOUPI_ALLOW_LOCALHOST_MODE=true
# CLOUDFLARE_DOMAIN=example.com
# DEPLOYMENT_PREFIX=pay

# Public URLs as seen by customers' browsers (localhost mode).
BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001

# ── Secrets (generated) ──
# Bearer token for the gateway admin API; used by `npm run gateway:configure`.
ADMIN_API_TOKEN=
OBSERVER_API_TOKEN=
ENCRYPTION_MASTER_KEY=
JWT_SECRET=
ANDROID_ENROLLMENT_SECRET=
INITIAL_ADMIN_EMAIL=admin@youpi.local
INITIAL_ADMIN_PASSWORD=

# ── Webhooks ──
# Needed while the store runs on localhost / a LAN address. Remove in production
# (the store's public https URL doesn't need it).
YOUPI_ALLOW_PRIVATE_WEBHOOKS=true

# ── Local testing only ──
# With YOUPI_MODE=localhost, set NODE_ENV=development and enable these to test
# without WhatsApp or a bank observer. Production mode always forces them off.
# YOUPI_EXPOSE_DEV_OTP=true     # return the customer OTP to the checkout instead of sending it
# YOUPI_ALLOW_DEV_TOOLS=true    # Merchant Admin developer simulator (inject a fake bank alert)
