# UpStore Docker deployment settings.
# Copy to .env.docker (gitignored), fill in, then:
#   docker compose --env-file .env.docker up -d --build
# Values marked [build] are compiled into the app: rebuild after changing them.

# ── Supabase (Project Settings → API Keys) ──
# [build]
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# [build]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# ── Public URLs ──
# Where customers reach the store (used in emails, auth redirects, payment returns).
# [build]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where customers reach the payment checkout (container port 7000).
# e.g. https://pay.yourstore.com behind a reverse proxy, or http://<server-ip>:7000
YOUPI_PUBLIC_CHECKOUT_URL=http://localhost:7000

# ── Payments ──
# youpi (default): run the bundled gateway · fake: test payment page, gateway not started
PAYMENT_PROVIDER=youpi
# Your UPI ID: payments are sent here. Applied on every start.
YOUPI_UPI_ID=
YOUPI_PAYEE_NAME=
# Name shown on the hosted checkout.
STORE_NAME=UpStore
# Optional. Auto-generated and kept in the data volume when empty.
# ADMIN_API_TOKEN=
# YOUPI_WEBHOOK_SECRET=
# Optional: YouPI's own production mode via its Cloudflare Tunnel (see docs/PAYMENTS.md).
# CLOUDFLARE_DOMAIN=
# DEPLOYMENT_PREFIX=pay

# ── Email (Gmail SMTP; leave SMTP_USER/SMTP_PASS empty to disable) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UpStore <you@gmail.com>"
MAIL_ADMIN_TO=

# ── Host ports (optional) ──
# STORE_PORT=3000
# CHECKOUT_PORT=7000
# ADMIN_PORT=6001
