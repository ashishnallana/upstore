# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Secret key (sb_secret_...) or the legacy "service_role" key. Server only, never expose.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Public URL of this app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "fake" (test page, default) or "youpi"
PAYMENT_PROVIDER=fake

# YouPI PG (only when PAYMENT_PROVIDER=youpi). `npm run gateway:configure` fills these in.
# Payment API base URL (port 6100 by default), not the checkout portal.
YOUPI_API_URL=http://localhost:6100
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# Merchant webhook secret; also used as the API key unless YOUPI_API_KEY is set. Server only.
YOUPI_WEBHOOK_SECRET=
# YOUPI_API_KEY=
# Public origin customers are sent to for checkout (the gateway reports http://localhost:7000 in localhost mode).
# YOUPI_PUBLIC_CHECKOUT_URL=https://pay.example.com

# ── Email (Gmail SMTP) ──
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords),
# not your normal password. Leave SMTP_USER/SMTP_PASS empty to disable sending (emails are logged as skipped).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to customers. With Gmail the address must be SMTP_USER or a verified "Send mail as" alias.
MAIL_FROM="UpStore <you@gmail.com>"
# Where new-order alerts go (optional).
MAIL_ADMIN_TO=
